{
  "manifest_version": 3,
  "name": "Frozen",
  "version": "0.1.0",
  "description": "Frozen — system-level website & app blocker",
  "key": "",
  "minimum_chrome_version": "102",
  "permissions": [
    "nativeMessaging",
    "webNavigation",
    "tabs",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["rules.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "blocked.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
