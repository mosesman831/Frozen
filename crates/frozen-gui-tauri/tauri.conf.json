{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Frozen",
  "version": "0.1.0",
  "identifier": "com.frozen.app",
  "build": {
    "frontendDist": "./ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Frozen",
        "width": 1380,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720,
        "devtools": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; script-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
